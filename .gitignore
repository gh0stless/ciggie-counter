.claude/

# --- KiCad: Sperr-/Cache-/Nutzerdateien ---
*.lck
*.kicad_prl
fp-info-cache
*-backups/
# erzeugte Fertigungsdaten (hardware/kicad/tools/gen_fab.py)
hardware/kicad/*/fertigung/
# erzeugt von hardware/freecad/knauf.py (Modell, STL, Platine als STEP)
hardware/freecad/*.FCStd
hardware/freecad/*.FCBak
hardware/freecad/stl/
hardware/freecad/*.step
# Ascher-Referenzmodell als Austauschformat (STEP, OBJ fuer Blender) bleibt im Repo
!hardware/freecad/ascher_value.step

# --- Fremdcode, wird per Anleitung geholt ---
firmware/tc_ble_sdk/
nextcloud-app/cigarettecounter/vendor/

# --- Interne Notizen (private Infrastruktur, bleiben lokal) ---
handover_superascher.md
hardware-handover.md
einkaufsliste.md
nextcloud-app/PROJEKT.md
nextcloud-app/docs/
nextcloud-app/backups/

# --- Fremde Dokumente und Bilder (Urheberrecht) ---
datasheets/*.pdf
design/referenz_*

# --- Altlast: leerer Ordner der früheren Bridge-App ---
/android/

# Original der Projekt-Flagge (Name nicht öffentlich), im Repo als design/brand-flag.jpg
design/KKK Flagge.jpg

# eigenes Repo (gh0stless/ciggie-counter-ha)
